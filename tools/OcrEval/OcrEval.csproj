<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates an Arabic/English/mixed OCR corpus, runs the app's OCR pipeline on it (plus any
       real samples supplied with ground truth) and reports character/word error rates. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>OcrEval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Toolbox.Core\Toolbox.Core.csproj" />
    <ProjectReference Include="..\..\src\Toolbox.Processing\Toolbox.Processing.csproj" />
    <ProjectReference Include="..\..\src\Toolbox.Windows.Ocr\Toolbox.Windows.Ocr.csproj" />
  </ItemGroup>

</Project>
