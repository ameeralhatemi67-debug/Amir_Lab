<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates src/Toolbox.Windows/app.ico from the glyph the app draws at runtime (Shell/AppIcon.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>IconGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Toolbox.Windows\Toolbox.Windows.csproj" />
  </ItemGroup>

</Project>