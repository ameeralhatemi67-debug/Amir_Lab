<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows target so the CLI can use Windows' built-in OCR; the rest of the CLI is platform-neutral. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>ftb</AssemblyName>
    <RootNamespace>Toolbox.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolbox.Core\Toolbox.Core.csproj" />
    <ProjectReference Include="..\Toolbox.Processing\Toolbox.Processing.csproj" />
    <ProjectReference Include="..\Toolbox.Windows.Ocr\Toolbox.Windows.Ocr.csproj" />
  </ItemGroup>

</Project>
