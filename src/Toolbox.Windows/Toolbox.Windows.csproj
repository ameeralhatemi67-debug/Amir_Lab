<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows desktop adapter: activation, native drops, wheel, editors, tray, shell integration. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection for Windows.Media.Ocr (via Toolbox.Windows.Ocr). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AmirLap</AssemblyName>
    <!-- Program.Main answers Claude Code's quick Pulse runs before WPF starts; otherwise it runs App. -->
    <StartupObject>Toolbox.Windows.Program</StartupObject>
    <RootNamespace>Toolbox.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/IconGen from the glyph in Shell/AppIcon.cs; regenerate rather than edit. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 targets WinForms apps; this is a WPF app whose manifest declares PerMonitorV2 on purpose. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespaces out of implicit usings
         so WPF types (Application, MessageBox, Point...) stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ReadyToRun would triple these large assemblies for no start-up gain: the 24 MB Windows SDK
         projection (only OCR uses it) and OpenXML (only Word export uses it). -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="DocumentFormat.OpenXml.dll" />
    <PublishReadyToRunExclude Include="DocumentFormat.OpenXml.Framework.dll" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toolbox.Windows.Tests" />
    <InternalsVisibleTo Include="IconGen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolbox.Core\Toolbox.Core.csproj" />
    <ProjectReference Include="..\Toolbox.Processing\Toolbox.Processing.csproj" />
    <ProjectReference Include="..\Toolbox.Windows.Ocr\Toolbox.Windows.Ocr.csproj" />
  </ItemGroup>

</Project>
