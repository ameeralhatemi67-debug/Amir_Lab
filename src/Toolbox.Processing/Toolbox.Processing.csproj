<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local processing engines. Platform-neutral code; native binaries are currently win-x64. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Toolbox.Processing</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolbox.Core\Toolbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    <!-- PINNED: 6.2.x is MIT. PDFsharp 6.5.0 switched to AGPL-3.0 with a runtime licence check.
         Do not upgrade without an explicit licensing decision (see docs/DECISIONS.md). -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toolbox.Processing.Tests" />
  </ItemGroup>

</Project>
